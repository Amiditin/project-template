{
  "name": "@rees46/chain-library",
  "version": "2.1.1",
  "description": "REES46 Chain library",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "installConfig": {
    "hoistingLimits": "dependencies"
  },
  "scripts": {
    "dev": "webpack-dev-server --progress --port 8081",
    "sass": "sass -I ./node_modules --no-source-map src/chains.scss ./css/chains.css",
    "build": "webpack --mode=production",
    "watch": "webpack --watch",
    "prepack": "run sass && run build && mkdir -p dist/scss && cp -r src/*.scss dist/scss && cp -r css dist",
    "changelog": "standard-changelog --commit-path ."
  },
  "author": "Sergey Odintsov <nixx.dj@gmail.com> (https://github.com/PNixx)",
  "license": "ISC",
  "dependencies": {
    "@rees46/segmentator-library": "workspace:*"
  },
  "devDependencies": {
    "@babel/cli": "7.24.7",
    "@babel/core": "7.24.7",
    "@babel/plugin-transform-modules-umd": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "babel-loader": "9.1.3",
    "sass": "~1.49.9",
    "standard-changelog": "6.0.0",
    "webpack": "5.93.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.4"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "dist/index.js",
    "exports": {
      ".": "./dist/index.js"
    },
    "access": "public"
  }
}
