{
  "name": "@rees46/chain-library",
  "version": "2.0.2",
  "description": "REES46 Chain library",
  "main": "index.js",
  "installConfig": {
    "hoistingLimits": "dependencies"
  },
  "scripts": {
    "dev": "webpack-dev-server --progress --port 8081",
    "sass": "./node_modules/sass/sass.js -I ./node_modules --no-source-map src/chains.scss ./css/chains.css",
    "build": "./node_modules/.bin/webpack --mode=production",
    "prepack": "run sass && run build && mkdir -p dist/scss && cp -r src/*.scss dist/scss && cp -r css dist"
  },
  "author": "Sergey Odintsov <nixx.dj@gmail.com> (https://github.com/PNixx)",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.5",
    "@babel/plugin-transform-modules-umd": "^7.16.7",
    "@babel/preset-env": "^7.16.11",
    "babel-loader": "^8.2.3",
    "sass": "~1.49.9",
    "webpack": "5.90.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  },
  "dependencies": {
    "@rees46/segmentator-library": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "dist/index.js",
    "access": "public"
  }
}
